	(text "GPIO(20x 3.3V, 9x 1.8V):\n---\n1.8V:\n1x for Carrier Board NOR Flash Reset\n1x for ADCS Load Switch (shifted to 3.3V)\n1x for CMOS Image Sensor (shifted to 3.3V)\n6x for Breakout Connector (shifted to 3.3V)\n\n3.3V:\n5x for EBYTE Transceiver Board\n2x for Preliminary Heater Trigger Connection\n4x for Electrical Power System Board Connection\n4x for Payload Board Connection\n4x for Preliminary ADCS Connection\n1x for SATNOGS Load Switch\n\n\n"
		(exclude_from_sim no)
		(at 12.7 164.084 0)
